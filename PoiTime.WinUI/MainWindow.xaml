<Window
    x:Class="PoiTime.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:local="using:PoiTime.WinUI"  Title="PoiTime!">

    <Grid Loaded="RootGrid_Loaded">

        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/favicon.ico"
                        ToolTipText="PoiTime!"
                        DoubleClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="显示主页" Command="{x:Bind ShowWindowCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE700;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="测试报时" Command="{x:Bind TestVoiceCommand}"/>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="退出" Command="{x:Bind ExitCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <NavigationView x:Name="NavView" 
                        PaneDisplayMode="Left" 
                        IsPaneOpen="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" 
                        OpenPaneLength="160"  
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.PaneHeader>
                <Grid Margin="0,38,0,10"/>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Home" Content="主页" Icon="Home" IsSelected="True"/>
                <NavigationViewItem Tag="Download" Content="下载" Icon="Download"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings" Content="设置" Icon="Setting"/>
                <NavigationViewItem Tag="About" Content="关于">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Margin="0,15,0,0" Padding="20">

                <Grid x:Name="HomeContent" Visibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="主页" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox x:Name="HomeSearchBox" Grid.Column="2" PlaceholderText="搜索名称或ID" Width="220" 
                                 VerticalAlignment="Center" TextChanged="HomeSearchBox_TextChanged"/>
                    </Grid>

                    <ListView x:Name="InstalledVoicePackListView" Grid.Row="1" SelectionMode="None" HorizontalAlignment="Stretch" MaxWidth="800">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0,0,0,12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VoicePackModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind DisplayId}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Button Content="{x:Bind PreviewButtonText, Mode=OneWay}" 
                                                    Tag="{x:Bind}" 
                                                    Click="TestVoiceCardBtn_Click"
                                                    Style="{x:Bind local:MainWindow.GetPreviewButtonStyle(IsPreviewPlaying), Mode=OneWay}"/>
                                            <Button Content="{x:Bind ActiveButtonText, Mode=OneWay}" 
                                                    IsEnabled="{x:Bind IsActiveButtonEnabled, Mode=OneWay}"
                                                    Style="{StaticResource AccentButtonStyle}" 
                                                    Tag="{x:Bind}" 
                                                    Click="SetActiveCardBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" Padding="10,15,10,0" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button x:Name="HomePrevPageBtn" Content="上一页" Click="HomePrevPageBtn_Click"/>
                            <TextBlock x:Name="HomePageInfoText" Text="1 / 1" VerticalAlignment="Center" Margin="5,0"/>
                            <Button x:Name="HomeNextPageBtn" Content="下一页" Click="HomeNextPageBtn_Click"/>

                            <TextBlock Text="跳至:" VerticalAlignment="Center" Margin="15,0,0,0"/>
                            <TextBox x:Name="HomeJumpPageBox" Width="40" Text="1" VerticalAlignment="Center" TextAlignment="Center"/>
                            <Button Content="跳转" Click="HomeJumpPageBtn_Click" VerticalAlignment="Center"/>

                            <ComboBox x:Name="HomeItemsPerPageCombo" VerticalAlignment="Center" Margin="15,0,0,0" SelectionChanged="HomeItemsPerPageCombo_SelectionChanged">
                                <ComboBoxItem Content="5 个/页" Tag="5" IsSelected="True"/>
                                <ComboBoxItem Content="10 个/页" Tag="10"/>
                                <ComboBoxItem Content="20 个/页" Tag="20"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="DownloadContent" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="获取新语音包" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="刷新列表" Margin="0,0,15,0" VerticalAlignment="Center" Click="RefreshUpdateJson_Click"/>
                        <TextBox x:Name="SearchBox" Grid.Column="3" PlaceholderText="搜索名称或ID" Width="220" 
                                 VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                    </Grid>

                    <ProgressRing x:Name="DownloadLoadingRing" Grid.Row="1" IsActive="False" Visibility="Collapsed" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <ListView x:Name="VoicePackListView" Grid.Row="1" SelectionMode="None" HorizontalAlignment="Stretch" MaxWidth="800">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0,0,0,12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VoicePackModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind DisplayId}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                            <ItemsControl ItemsSource="{x:Bind SpecialTags}" Visibility="{x:Bind TagsVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1A0078D7" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#0078D7" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="下载" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind}" Click="DownloadVoiceBtn_Click" Visibility="{x:Bind DownloadBtnVisibility, Mode=OneWay}"/>
                                            <Button Content="删除" Tag="{x:Bind}" Click="DeleteVoiceBtn_Click" Visibility="{x:Bind DeleteBtnVisibility, Mode=OneWay}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" Padding="10,15,10,0" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button x:Name="PrevPageBtn" Content="上一页" Click="PrevPageBtn_Click"/>
                            <TextBlock x:Name="PageInfoText" Text="1 / 1" VerticalAlignment="Center" Margin="5,0"/>
                            <Button x:Name="NextPageBtn" Content="下一页" Click="NextPageBtn_Click"/>

                            <TextBlock Text="跳至:" VerticalAlignment="Center" Margin="15,0,0,0"/>
                            <TextBox x:Name="JumpPageBox" Width="40" Text="1" VerticalAlignment="Center" TextAlignment="Center"/>
                            <Button Content="跳转" Click="JumpPageBtn_Click" VerticalAlignment="Center"/>

                            <ComboBox x:Name="ItemsPerPageCombo" VerticalAlignment="Center" Margin="15,0,0,0" SelectionChanged="ItemsPerPageCombo_SelectionChanged">
                                <ComboBoxItem Content="5 个/页" Tag="5" IsSelected="True"/>
                                <ComboBoxItem Content="10 个/页" Tag="10"/>
                                <ComboBoxItem Content="20 个/页" Tag="20"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsContent" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <StackPanel Spacing="20">
                        <TextBlock Text="设置" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="系统与高级功能" FontWeight="SemiBold" Margin="0,0,0,-10"/>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Stretch">

                            <StackPanel Spacing="16">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="开机自动启动" FontSize="16" FontWeight="Medium"/>
                                        <TextBlock Text="让程序在电脑开机时自动在后台为你报时" 
                                                   FontSize="12" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoStartToggle" 
                                                  Grid.Column="1" 
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right"
                                                  MinWidth="0" Margin="0"
                                                  OnContent="{x:Null}" OffContent="{x:Null}" 
                                                  Toggled="AutoStartToggle_Toggled"/>
                                </Grid>

                                <MenuFlyoutSeparator Margin="0,4,0,4"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="自定义语音包下载" FontSize="16" FontWeight="Medium"/>
                                        <TextBlock Text="通过输入 kcwiki 的 ID 手动拉取特定舰娘语音" 
                                                   FontSize="12" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" 
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Right"
                                            Margin="0"
                                            Content="打开下载面板" 
                                            Click="OpenCustomDownload_Click"/>
                                </Grid>

                                <MenuFlyoutSeparator Margin="0,4,0,4"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="语音包订阅源" FontSize="16" FontWeight="Medium"/>
                                        <TextBlock Text="自定义 update.json 的获取地址，默认使用官方源" 
                                                   FontSize="12" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBox x:Name="UpdateJsonUrlBox" 
                                                 Width="250" 
                                                 PlaceholderText="输入自定义链接..."
                                                 LostFocus="UpdateJsonUrlBox_LostFocus"
                                                 KeyDown="UpdateJsonUrlBox_KeyDown"/>
                                        <Button Content="恢复官方源" Click="RestoreDefaultUrl_Click"/>
                                    </StackPanel>
                                </Grid>

                                <MenuFlyoutSeparator Margin="0,4,0,4"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="同时下载文件数" FontSize="16" FontWeight="Medium"/>
                                        <TextBlock Text="数量越多速度越快，但可能会造成轻微的网络拥堵" 
                                                   FontSize="12" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <ComboBox x:Name="MaxThreadsCombo" 
                                              Grid.Column="1" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Right"
                                              Width="150"
                                              SelectionChanged="MaxThreadsCombo_SelectionChanged">
                                        <ComboBoxItem Content="1 线程" Tag="1"/>
                                        <ComboBoxItem Content="3 线程" Tag="3"/>
                                        <ComboBoxItem Content="5 线程" Tag="5"/>
                                        <ComboBoxItem Content="10 线程" Tag="10"/>
                                    </ComboBox>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="AboutContent" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                        <TextBlock Text="关于 PoiTime!" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="30,25">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <PersonPicture Grid.Column="0" 
                                               ProfilePicture="/Assets/avatar.png" 
                                               Width="64" Height="64" 
                                               CornerRadius="12" 
                                               Margin="0,0,25,0" 
                                               VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="PoiTime!" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="1.0.0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="一款现代化的 Windows 桌面整点语音报时工具。让舰娘的声音陪伴你的每一小时。" 
                                               FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="制作团队与版权说明" FontWeight="SemiBold" Margin="0,15,0,-10"/>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7FD;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="制作人" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="shamirone" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="核心程序 / 界面设计" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <MenuFlyoutSeparator/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE909;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="语音文件来源" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="版权归KCWIKI所有，侵删" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <MenuFlyoutSeparator/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE1A2;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}" Margin="0,0,15,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="法律声明" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="本项目免费开源，仅供学习交流。所有语音及图像数据版权均归来源方及相关权利人所有。请勿用于商业用途。" 
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </NavigationView>

        <Border x:Name="ToastNotification" 
                Background="{ThemeResource SystemFillColorSuccessBrush}" 
                CornerRadius="8" Padding="16,12" 
                HorizontalAlignment="Center" VerticalAlignment="Top" 
                Margin="0,60,0,0" 
                Visibility="Collapsed"
                Canvas.ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE73E;" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Text="设置成功" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid x:Name="FloatingProgressPanel" 
              HorizontalAlignment="Right" 
              VerticalAlignment="Bottom" 
              Margin="0,0,24,24" 
              Visibility="Collapsed">

            <Grid.Shadow>
                <ThemeShadow/>
            </Grid.Shadow>

            <Expander x:Name="DownloadExpander" 
                      ExpandDirection="Up" 
                      IsExpanded="True" 
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Width="400">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="MiniProgressRing" IsActive="True" Width="16" Height="16"/>
                        <TextBlock x:Name="DownloadStatusTitle" Text="正在准备下载..." VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Expander.Header>

                <Expander.Content>
                    <StackPanel Spacing="10" Padding="10,5,10,10">
                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="DownloadDetailText" 
                                   Text="正在连接并准备计算速度..." 
                                   FontSize="12" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander.Content>
            </Expander>
        </Grid>
    </Grid>
</Window>