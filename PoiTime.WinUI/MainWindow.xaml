<Window
    x:Class="PoiTime.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:local="using:PoiTime.WinUI"
    Title="PoiTime!">

    <Grid Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.RowSpan="2"
                        IconSource="/Assets/favicon.ico"
                        ToolTipText="PoiTime!"
                        DoubleClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="显示主页" Command="{x:Bind ShowWindowCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE700;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="退出" Command="{x:Bind ExitCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="16,0"
              Background="Transparent"
              Canvas.ZIndex="10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image Source="/Assets/favicon.ico" Width="16" Height="16" Stretch="Uniform" />
                </Border>
                <TextBlock Text="PoiTime!" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="208"
                        Background="Transparent"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Home" Content="主页" Icon="Home" IsSelected="True" />
                <NavigationViewItem Tag="Download" Content="下载" Icon="Download" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings" Content="设置" Icon="Setting" />
                <NavigationViewItem Tag="About" Content="关于">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="28,8,28,20">
                <Grid x:Name="HomeContent"
                      Visibility="Visible"
                      MaxWidth="1080"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="AnnouncementCard"
                            Grid.Row="0"
                            Margin="0,0,0,20"
                            Padding="24"
                            CornerRadius="14"
                            Background="#3F6F8F">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock x:Name="AnnouncementEyebrowText"
                                           Text="POITIME · 官方公告"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#D9FFFFFF" />
                                <TextBlock x:Name="AnnouncementTitleText"
                                           Text="欢迎来到 PoiTime!"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="AnnouncementContentText"
                                           Text="选择语音包、试听报时，剩下的交给后台。"
                                           FontSize="13"
                                           Foreground="#D9FFFFFF"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox x:Name="HomeSearchBox"
                                     Grid.Column="1"
                                     PlaceholderText="搜索已安装的语音"
                                     Width="220"
                                     VerticalAlignment="Center"
                                     TextChanged="HomeSearchBox_TextChanged" />
                        </Grid>
                    </Border>

                    <ListView x:Name="InstalledVoicePackListView"
                              Grid.Row="1"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch"
                              MaxWidth="960"
                              ItemContainerStyle="{StaticResource VoicePackListItemStyle}">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="18" IsStaggeringEnabled="True" />
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VoicePackModel">
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Style="{StaticResource VoicePackIconContainerStyle}"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="19"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,20,0">
                                            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind DisplayId}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Button Content="{x:Bind PreviewButtonText, Mode=OneWay}"
                                                    Tag="{x:Bind}"
                                                    MinWidth="80"
                                                    Click="TestVoiceCardBtn_Click"
                                                    Style="{x:Bind local:MainWindow.GetPreviewButtonStyle(IsPreviewPlaying), Mode=OneWay}" />
                                            <Button Content="{x:Bind ActiveButtonText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind IsActiveButtonEnabled, Mode=OneWay}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    MinWidth="80"
                                                    Click="SetActiveCardBtn_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorderStyle}"
                            MaxWidth="960"
                            Padding="32"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind local:MainWindow.GetEmptyVisibility(_pagedInstalledPacks.Count), Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                            <Border Width="56" Height="56" CornerRadius="28"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE8F1;" FontSize="26"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="没有找到已安装的语音包"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="试试其他搜索关键词，或前往“下载”页面获取新语音包。"
                                       Style="{StaticResource PageDescriptionTextStyle}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,16,0,0" MaxWidth="960">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button x:Name="HomePrevPageBtn" Content="上一页" MinWidth="76" Click="HomePrevPageBtn_Click" />
                            <TextBlock x:Name="HomePageInfoText" Text="1 / 1" VerticalAlignment="Center" Margin="6,0" />
                            <Button x:Name="HomeNextPageBtn" Content="下一页" MinWidth="76" Click="HomeNextPageBtn_Click" />
                            <Button Content="跳至" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox x:Name="HomeJumpPageBox" Width="64" Text="1" TextAlignment="Center" />
                                            <Button Content="跳转" Click="HomeJumpPageBtn_Click" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <ComboBox x:Name="HomeItemsPerPageCombo"
                                      VerticalAlignment="Center"
                                      MinWidth="112"
                                      Margin="8,0,0,0"
                                      SelectionChanged="HomeItemsPerPageCombo_SelectionChanged">
                                <ComboBoxItem Content="5 个/页" Tag="5" IsSelected="True" />
                                <ComboBoxItem Content="10 个/页" Tag="10" />
                                <ComboBoxItem Content="20 个/页" Tag="20" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="DownloadContent"
                      Visibility="Collapsed"
                      MaxWidth="1080"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="5">
                            <TextBlock Text="获取新语音包" Style="{StaticResource PageTitleTextStyle}" />
                            <TextBlock Text="浏览、搜索并安装新的舰娘语音包。"
                                       Style="{StaticResource PageDescriptionTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
                            <Button Content="刷新列表" VerticalAlignment="Center" Click="RefreshUpdateJson_Click" />
                            <TextBox x:Name="SearchBox"
                                     PlaceholderText="搜索名称或 ID"
                                     Width="280"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" />
                        </StackPanel>
                    </Grid>

                    <ProgressRing x:Name="DownloadLoadingRing"
                                  Grid.Row="1"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  Width="40"
                                  Height="40"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Canvas.ZIndex="2" />

                    <ListView x:Name="VoicePackListView"
                              Grid.Row="1"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch"
                              MaxWidth="960"
                              ItemContainerStyle="{StaticResource VoicePackListItemStyle}">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="18" IsStaggeringEnabled="True" />
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VoicePackModel">
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource VoicePackIconContainerStyle}"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8F1;" FontSize="19"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="4"
                                                    Margin="0,0,24,0">
                                            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind DisplayId}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Grid Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="下载"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Tag="{x:Bind}"
                                                    MinWidth="96"
                                                    Click="DownloadVoiceBtn_Click"
                                                    Visibility="{x:Bind DownloadBtnVisibility, Mode=OneWay}" />
                                            <Button Content="删除"
                                                    Tag="{x:Bind}"
                                                    MinWidth="96"
                                                    Click="DeleteVoiceBtn_Click"
                                                    Visibility="{x:Bind DeleteBtnVisibility, Mode=OneWay}" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1"
                                                      Grid.Column="1"
                                                      Grid.ColumnSpan="2"
                                                      Margin="0,14,0,-6"
                                                      ItemsSource="{x:Bind SpecialTags}"
                                                      Visibility="{x:Bind TagsVisibility}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            CornerRadius="5"
                                                            Padding="8,4"
                                                            Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding}" FontSize="11"
                                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorderStyle}"
                            MaxWidth="960"
                            Padding="32"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind local:MainWindow.GetEmptyVisibility(_pagedVoicePacks.Count), Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                            <Border Width="56" Height="56" CornerRadius="28"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE896;" FontSize="26"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="暂无可显示的语音包"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="调整搜索关键词，或刷新列表以获取最新的语音包。"
                                       Style="{StaticResource PageDescriptionTextStyle}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,16,0,0" MaxWidth="960">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button x:Name="PrevPageBtn" Content="上一页" MinWidth="76" Click="PrevPageBtn_Click" />
                            <TextBlock x:Name="PageInfoText" Text="1 / 1" VerticalAlignment="Center" Margin="6,0" />
                            <Button x:Name="NextPageBtn" Content="下一页" MinWidth="76" Click="NextPageBtn_Click" />
                            <Button Content="跳至" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox x:Name="JumpPageBox" Width="64" Text="1" TextAlignment="Center" />
                                            <Button Content="跳转" Click="JumpPageBtn_Click" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <ComboBox x:Name="ItemsPerPageCombo"
                                      VerticalAlignment="Center"
                                      MinWidth="112"
                                      Margin="8,0,0,0"
                                      SelectionChanged="ItemsPerPageCombo_SelectionChanged">
                                <ComboBoxItem Content="5 个/页" Tag="5" IsSelected="True" />
                                <ComboBoxItem Content="10 个/页" Tag="10" />
                                <ComboBoxItem Content="20 个/页" Tag="20" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsContent"
                      Visibility="Collapsed"
                      MaxWidth="1080"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
                        <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="管理启动方式、下载来源与并发行为。"
                                   Style="{StaticResource PageDescriptionTextStyle}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">
                        <StackPanel MaxWidth="900" Spacing="12" HorizontalAlignment="Stretch">
                            <TextBlock Text="启动" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,2" />
                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="5" Margin="0,0,24,0">
                                            <TextBlock Text="开机自动启动" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="登录 Windows 后在后台运行，并按时播放语音。"
                                                       Style="{StaticResource PageDescriptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoStartToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right"
                                                      MinWidth="0"
                                                      Margin="0"
                                                      OnContent="{x:Null}"
                                                      OffContent="{x:Null}"
                                                      Toggled="AutoStartToggle_Toggled" />
                                    </Grid>

                                    <Grid x:Name="HighPriorityContainer" Visibility="Collapsed" Margin="0,20,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Height="1" Margin="0,0,0,20"
                                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="5" Margin="0,0,24,0">
                                                <TextBlock Text="高优先级启动" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="通过 Windows 服务更早启动，需要一次性管理员授权，不提升运行性能。"
                                                           Style="{StaticResource PageDescriptionTextStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="HighPriorityToggle"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Right"
                                                          MinWidth="0"
                                                          Margin="0"
                                                          OnContent="{x:Null}"
                                                          OffContent="{x:Null}"
                                                          Toggled="HighPriorityToggle_Toggled" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="下载与网络" Style="{StaticResource SectionTitleTextStyle}" Margin="0,16,0,2" />
                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="5" Margin="0,0,24,0">
                                        <TextBlock Text="自定义语音包下载" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="输入 kcwiki ID，手动获取指定舰娘的语音包。"
                                                   Style="{StaticResource PageDescriptionTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="0"
                                            Content="打开下载面板"
                                            Click="OpenCustomDownload_Click" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="语音包订阅源" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="设置 update.json 的获取地址，留空时使用官方源。"
                                                   Style="{StaticResource PageDescriptionTextStyle}" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="UpdateJsonUrlBox"
                                                 Grid.Column="0"
                                                 MinWidth="0"
                                                 PlaceholderText="输入自定义订阅源链接"
                                                 LostFocus="UpdateJsonUrlBox_LostFocus"
                                                 KeyDown="UpdateJsonUrlBox_KeyDown" />
                                        <Button Grid.Column="1" Content="恢复官方源" Margin="10,0,0,0" Click="RestoreDefaultUrl_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="5" Margin="0,0,24,0">
                                        <TextBlock Text="同时下载文件数" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="提高并发可加快批量下载，也会增加网络占用。"
                                                   Style="{StaticResource PageDescriptionTextStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="MaxThreadsCombo"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Width="150"
                                              SelectionChanged="MaxThreadsCombo_SelectionChanged">
                                        <ComboBoxItem Content="1 线程" Tag="1" />
                                        <ComboBoxItem Content="3 线程" Tag="3" />
                                        <ComboBoxItem Content="5 线程" Tag="5" />
                                        <ComboBoxItem Content="10 线程" Tag="10" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="AboutContent"
                      Visibility="Collapsed"
                      MaxWidth="1080"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
                        <TextBlock Text="关于 PoiTime!" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="应用信息、制作团队与版权说明。"
                                   Style="{StaticResource PageDescriptionTextStyle}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">
                        <StackPanel MaxWidth="900" Spacing="12" HorizontalAlignment="Stretch">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Grid.Column="0"
                                                   ProfilePicture="/Assets/avatar.png"
                                                   Width="72"
                                                   Height="72"
                                                   CornerRadius="12"
                                                   Margin="0,0,22,0"
                                                   VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="PoiTime!" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind AppVersion}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="一款现代、轻巧的 Windows 整点语音报时工具，让舰娘的声音陪伴你的每一小时。"
                                                   FontSize="13"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="制作团队与版权说明" Style="{StaticResource SectionTitleTextStyle}" Margin="0,16,0,2" />
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <FontIcon Glyph="&#xE7FD;" FontSize="17"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="制作人" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="shamirone" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="核心程序 / 界面设计" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <FontIcon Glyph="&#xE909;" FontSize="17"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="语音文件来源" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="语音文件来自 KCWIKI，相关版权归原权利人所有。"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <FontIcon Glyph="&#xE1A2;" FontSize="17"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="法律声明" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="本项目免费开源，仅供学习交流。所有语音及图像数据版权均归来源方及相关权利人所有，请勿用于商业用途。"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>

        <InfoBar x:Name="ToastNotification"
                 Grid.RowSpan="2"
                 Severity="Success"
                 IsOpen="False"
                 IsClosable="False"
                 MaxWidth="520"
                 Margin="20,52,20,0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Canvas.ZIndex="100" />

        <Grid x:Name="FloatingProgressPanel"
              Grid.Row="1"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,24,24"
              Visibility="Collapsed"
              Canvas.ZIndex="20">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Expander x:Name="DownloadExpander"
                      ExpandDirection="Up"
                      IsExpanded="True"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Width="400">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="MiniProgressRing" IsActive="True" Width="16" Height="16" />
                        <TextBlock x:Name="DownloadStatusTitle" Text="正在准备下载..." VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="10" Padding="10,5,10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DownloadProgressText"
                                       Grid.Column="0"
                                       Text="正在准备文件..."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DownloadPercentText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="DownloadDetailText"
                                   Text="正在连接并准备计算速度..."
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Expander.Content>
            </Expander>
        </Grid>
    </Grid>
</Window>
